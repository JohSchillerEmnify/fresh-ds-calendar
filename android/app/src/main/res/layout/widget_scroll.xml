<?xml version="1.0" encoding="utf-8"?>
<!-- The scrolling widget: the Timeline's day names on top (hidden for the Agenda), the list below. Only RemoteViews-allowed
     classes (ScrollWidgetInflateTest). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="4dp"
        android:paddingTop="4dp">

        <LinearLayout
            android:id="@+id/head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/refresh"
                android:layout_width="26dp"
                android:layout_height="30dp"
                android:contentDescription="@string/widget_refresh"
                android:padding="4dp"
                android:src="@drawable/ic_refresh" />

            <TextView android:id="@+id/d0" style="@style/ScrollDayName" />
            <TextView android:id="@+id/d1" style="@style/ScrollDayName" />
            <TextView android:id="@+id/d2" style="@style/ScrollDayName" />
            <TextView android:id="@+id/d3" style="@style/ScrollDayName" />
            <TextView android:id="@+id/d4" style="@style/ScrollDayName" />
            <TextView android:id="@+id/d5" style="@style/ScrollDayName" />
            <TextView android:id="@+id/d6" style="@style/ScrollDayName" />
        </LinearLayout>

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="16dp"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
