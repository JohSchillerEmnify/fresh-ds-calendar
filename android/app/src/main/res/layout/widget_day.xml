<?xml version="1.0" encoding="utf-8"?>
<!-- The day is one bitmap (WeekCanvas.drawDay); the whole widget opens the day view, the icon refreshes. Only
     RemoteViews-allowed classes (WidgetInflateTest). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <ImageView
        android:id="@+id/canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/refresh"
        android:layout_width="22dp"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/widget_refresh"
        android:padding="3dp"
        android:src="@drawable/ic_refresh" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="16dp"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
