<?xml version="1.0" encoding="utf-8"?>
<!-- One day column of the week widget: highlight (today), weekday + date, up to ten event rows. Generated shape; edit by hand. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/col"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1">

    <ImageView
        android:id="@+id/col_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_col_bg"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="1dp"
        android:paddingVertical="2dp">

        <TextView
            android:id="@+id/head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingBottom="2dp"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row0"
            style="@style/WidgetRow" />
        <TextView
            android:id="@+id/row1"
            style="@style/WidgetRow" />
        <TextView
            android:id="@+id/row2"
            style="@style/WidgetRow" />
        <TextView
            android:id="@+id/row3"
            style="@style/WidgetRow" />
        <TextView
            android:id="@+id/row4"
            style="@style/WidgetRow" />
        <TextView
            android:id="@+id/row5"
            style="@style/WidgetRow" />
        <TextView
            android:id="@+id/row6"
            style="@style/WidgetRow" />
        <TextView
            android:id="@+id/row7"
            style="@style/WidgetRow" />
        <TextView
            android:id="@+id/row8"
            style="@style/WidgetRow" />
        <TextView
            android:id="@+id/row9"
            style="@style/WidgetRow" />
    </LinearLayout>
</FrameLayout>
