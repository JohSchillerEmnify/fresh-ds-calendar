<?xml version="1.0" encoding="utf-8"?>
<!-- The List widget (the Agenda). Refreshed with the week widget's WorkManager fetch and every data change, not by updatePeriodMillis. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/scroll_widget_description"
    android:initialLayout="@layout/widget_scroll"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="110dp"
    android:minWidth="110dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="3"
    android:targetCellWidth="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
