<?xml version="1.0" encoding="utf-8"?>
<!-- The Multi-day widget (the Timeline). Refreshed with the week widget's WorkManager fetch and every data change, not by
     updatePeriodMillis. Its days and hours in view come from the app's settings. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/multiday_widget_description"
    android:initialLayout="@layout/widget_scroll"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="110dp"
    android:minWidth="110dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="4"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
