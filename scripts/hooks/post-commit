#!/usr/bin/env bash
# Auto-deploy main after a merge. post-commit covers merges finished by hand after conflicts (merge commits only).
hook="$(basename "$0")"
if [ "$hook" = "post-commit" ]; then
  [ "$(git rev-list --parents -n1 HEAD | wc -w)" -ge 3 ] || exit 0   # not a merge commit
fi
# The persistent preview branch rebuilds its preview instead of deploying.
if [ "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" = "preview" ]; then
  exec /home/sauron/projects/calendar/scripts/auto-preview.sh
fi
exec /home/sauron/projects/calendar/scripts/auto-deploy.sh
