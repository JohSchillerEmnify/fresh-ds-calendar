{
  "minTokens": 50,
  "threshold": 0.577,
  "reporters": ["console", "html"],
  "output": ".jscpd-report",
  "gitignore": true,
  "absolute": false,
  "ignore": [
    "**/node_modules/**", "**/dist/**", "**/.features-gen/**", "**/test-results*/**",
    "**/*.test.ts", "**/coverage/**", "**/.jscpd-report/**", "android/**"
  ],
  "format": ["typescript", "javascript", "vue"]
}
