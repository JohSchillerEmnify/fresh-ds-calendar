# /opt/calendar/.env on the VPS, written by `scripts/vps.sh env`. Never commit the filled file.
PUBLIC_URL=https://cal.example.org
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=
TZ=Europe/Berlin
# Optional plugins (ADR 0004) — leave empty to keep them off. Door board: its bearer key (openssl rand -base64 32) and the person it sees.
DOOR_API_TOKEN=
DOOR_PERSON=
