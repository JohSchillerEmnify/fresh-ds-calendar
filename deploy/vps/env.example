# /opt/calendar/.env on the VPS, written by `scripts/vps.sh env`. Never commit the filled file.
CAL_DOMAIN=cal.example.org
PUBLIC_URL=https://cal.example.org
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=
TZ=Europe/Berlin
# Encrypts the stored Google refresh tokens: 32 random bytes, base64 (openssl rand -base64 32). Made on the VPS by `scripts/vps.sh deploy`; never leaves it.
TOKEN_ENC_KEY=
