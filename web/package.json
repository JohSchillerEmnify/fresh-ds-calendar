{
  "name": "@calendar/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/precompress.mjs",
    "build:e2e": "vite build && node scripts/precompress.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "size": "size-limit",
    "i18n:check": "node scripts/i18n-check.ts",
    "icons": "node scripts/gen-icons.mjs",
    "tokens": "UPDATE_TOKENS=1 vitest run test/theme.test.ts"
  },
  "dependencies": {
    "@calendar/shared": "workspace:*",
    "@material/material-color-utilities": "0.4.0",
    "@vueuse/core": "15.0.0",
    "date-fns": "4.4.0",
    "dompurify": "3.4.16",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-i18n": "11.4.12",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "1.2.95",
    "@size-limit/file": "14.2.0",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.2",
    "size-limit": "14.2.0",
    "typescript": "catalog:",
    "unplugin-icons": "24.0.0",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "catalog:",
    "vue-tsc": "3.3.13",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  }
}
