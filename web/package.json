{
  "name": "@calendar/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/precompress.mjs",
    "build:e2e": "vite build && node scripts/precompress.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "size": "size-limit",
    "i18n:check": "node scripts/i18n-check.ts",
    "icons": "node scripts/gen-icons.mjs",
    "tokens": "UPDATE_TOKENS=1 vitest run test/theme.test.ts"
  },
  "dependencies": {
    "@calendar/shared": "workspace:*",
    "@material/material-color-utilities": "0.4.0",
    "@vueuse/core": "15.0.0",
    "date-fns": "4.4.0",
    "dompurify": "3.4.17",
    "idb": "8.0.4",
    "leaflet": "1.9.4",
    "perfect-freehand": "1.2.3",
    "pinia": "4.1.0",
    "simplify-js": "1.2.4",
    "vue": "3.5.45",
    "vue-i18n": "11.4.18",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "1.2.98",
    "@iconify-json/ph": "1.2.2",
    "@iconify-json/pixelarticons": "1.2.10",
    "@iconify-json/solar": "1.2.14",
    "@size-limit/file": "14.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/browser-playwright": "5.1.0",
    "@vue/test-utils": "2.5.1",
    "jsdom": "31.0.0",
    "playwright": "1.65.0",
    "rollup-plugin-license": "3.7.2",
    "size-limit": "14.3.0",
    "typescript": "catalog:",
    "unplugin-icons": "24.0.0",
    "vite": "8.3.7",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "catalog:",
    "vitest-browser-vue": "3.1.0",
    "vue-tsc": "3.3.14",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  }
