model {
  extend calendar.server {
    prefsApi = component 'Prefs API' {
      description 'Validates and persists preference changes'
    }
    prefsStore = store 'Stored prefs' {
      description 'Per-person preferences on disk, the source of truth'
    }
    reminderOverrides = store 'Reminder overrides' {
      description 'The person\'s own reminders for events of calendars they can only read, which Google has no per-event reminders for'
    }
    tasksApi = component 'Tasks API' {
      description 'Creates and updates a person\'s task lists, their tags included'
    }
    calendarService = component 'Calendar service' {
      description 'Reads and writes one person\'s events and task lists through the calendar provider'
    }
    plugins = component 'Plugin registry' {
      description 'Mounts each optional plugin only when its configuration enables it, and lists the enabled ones in the health answer; ships with none'
    }

    itemsApi = component 'Items API' {
      description 'Answers the events and task lists of a date range, marked stale while Google holds the app back'
    }
    tasksCalendar = component 'Tasks calendar' {
      description 'Finds or creates each person\'s hidden "Calendar app: tasks" calendar, once per person'
    }
    taskCodec = library 'Task list codec' {
      description 'Turns a task list into a Google event and back (contract: API.md "Storage in Google")'
    }
    googleProvider = component 'Google provider' {
      description 'Talks to one person\'s Google Calendar with their token'
    }
    rateGuard = component 'Rate guard' {
      description 'One person\'s short read cache and cooldown in front of Google'
    }
    auth = component 'Sign-in' {
      description 'Signs a person in with Google, lets in only allowed addresses and keeps each person\'s Google access; on only with the real Google provider'
    }
    sessions = store 'Sessions and tokens' {
      description 'Sign-in sessions and each person\'s Google token on disk'
    }
    diag = component 'Diagnostics log' {
      description 'Writes one-line JSON log entries from a fixed list of fields, never personal data'
    }
    backup = component 'Backup' {
      description 'Backs up each person\'s server data to their Drive after changes, daily and on request, and restores it'
    }
    sharedLists = component 'Shared lists' {
      description 'Keeps task lists shared between people, checks who may see them and applies the category sharing rules'
    }
    sharedStore = store 'Shared lists store' {
      description 'One document per shared list, the category sharing rules and the known people, on disk'
    }
    mockProvider = component 'Mock provider' {
      description 'A Google Calendar stand-in kept on disk, for local runs and tests'
    }

    eventsApi = component 'Events API' {
      description 'Creates, changes and deletes a person\'s events, only those the person owns'
    }
    settingsApi = component 'Settings API' {
      description 'Keeps the settings and categories, one versioned file shared by everyone on the server'
    }
    configApi = component 'Config API' {
      description 'Answers the clock, week start, time zone and the build version'
    }
    releaseNotes = component 'Release notes' {
      description 'The newest user-facing notes from CHANGELOG.md, read once at start; none when the file is missing'
    }
    themesApi = component 'Themes API' {
      description 'Lists, saves and deletes a person\'s own themes, at most 20'
    }
    themeFiles = store 'Own themes' {
      description 'One file per own theme of a person, the document and its sanitised picture, on disk'
    }
    canvasApi = component 'Canvas API' {
      description 'Reads and replaces one person\'s Canvas areas as a whole document'
    }
    canvasStore = store 'Canvas areas' {
      description 'Each person\'s Canvas areas document on disk, not in Google'
    }
    templatesApi = component 'Templates API' {
      description 'Lists, saves, changes and deletes one person\'s task list templates'
    }
    templateStore = store 'Task list templates' {
      description 'Each person\'s task list templates on disk (name, items, estimate, category), not in Google'
    }
    changesApi = component 'Changes API' {
      description 'Answers what changed for one person since the device\'s opaque cursor, per kind: events through Google sync tokens (a full window on the first call or after 410 Gone), shared lists through their change stamps, per-person files through their versions'
    }
    liveApi = component 'Live updates API' {
      description 'Holds one Server-Sent Events connection per open app (session required) and sends a content-free changed nudge on it, with a keep-alive comment every 25 seconds'
    }
    changeFeed = component 'Change feed' {
      description 'Reads one person\'s events and task lists through one Google sync token per calendar; an expired token (410), a calendar new to the device or too many changed series give that calendar in full; one failing calendar leaves the others answered'
    }
    publisher = component 'Change publisher' {
      description 'The change bus: in-memory publish and subscribe, fed by one middleware that reports every successful write (and a restore or demo reset as every kind) to the person and to every member of a shared list; several server instances would need a shared broker (ADR 0030)'
    }
    googlePoller = component 'Google poller' {
      description 'While at least one app of a person is connected, asks Google for changes every 20 seconds through the sync tokens and publishes when there are any'
    }
    webPush = component 'Web Push' {
      description 'Each browser\'s push subscription and its reminder plan of the next 7 days'
    }

    motivation = component 'Motivation' {
      description 'Points, streak and plant state per person; every change bumps the X-Motivation-Changed header'
    }
    placeCodec = library 'Place codec' {
      description 'Maps an event\'s place to and from private Google event properties'
    }
    birthdayRules = library 'Birthday rules' {
      description 'Yearly birthday rule (29 Feb included), validation and whether the date is locked'
    }
    ownership = library 'Ownership rules' {
      description 'Why an event or calendar is look-only: an invitation or someone else\'s calendar'
    }
    calendarsApi = component 'Calendars API' {
      description 'Lists the person\'s calendars and sets one hidden or shown'
    }
    pushApi = component 'Push API' {
      description 'Serves the VAPID public key, takes subscriptions and the reminder plan'
    }
    backupApi = component 'Backup API' {
      description 'Lists, creates and restores Drive backups on request'
    }
    backupCollectors = component 'Backup collectors' {
      description 'Add the server-wide files to a backup, keeping only the person\'s own entries'
    }
    driveClient = component 'Drive client' {
      description 'The Drive interface with a Google and a mock implementation'
    }
    peopleStore = store 'People store' {
      description 'The person records on disk'
    }
    secretBox = library 'Secret box' {
      description 'AES-256-GCM seal and open with TOKEN_ENC_KEY (ADR 0026)'
    }
    securityHeaders = component 'Security headers' {
      description 'The CSP, which allows only the Photon and tile origins, and the other security headers'
    }
    apkDownload = component 'APK download' {
      description 'Serves the Android app and its version, sha256 and certificate fingerprint'
    }

    prefsApi -> prefsStore 'reads and writes'
    calendarService -> changeFeed 'reads the changes of events and task lists through it'
    changeFeed -> googleProvider 'lists each calendar by its sync token and a changed series by its instances'
    changesApi -> calendarService 'asks for the events changed since each calendar\'s sync token, limited to ±1 year, and every task list'
    calendarService -> googleProvider 'lists changes with a sync token per calendar; on 410 Gone lists the calendar again in full'
    liveApi -> publisher 'subscribes each open app to its person\'s nudges'
    liveApi -> sessions 'checks the session before opening the stream'
    publisher -> liveApi 'publishes changed to every open app of the person and of each list member'
    prefsApi -> publisher 'publishes after a saved change'
    tasksApi -> publisher 'publishes after a saved change'
    templatesApi -> publisher 'publishes after a saved change'
    canvasApi -> publisher 'publishes after a saved change'
    settingsApi -> publisher 'publishes after a saved change'
    themesApi -> publisher 'publishes after a saved change'
    eventsApi -> publisher 'publishes after a saved change'
    sharedLists -> publisher 'publishes to every member after a change'
    motivation -> publisher 'publishes after the streak or plant changed'
    googlePoller -> publisher 'publishes when Google reports changes'
    googlePoller -> calendarService 'asks for the events changed since each calendar\'s sync token'
    publisher -> googlePoller 'tells it which people have an app open'
    changesApi -> sharedLists 'reads the shared lists changed since the cursor'
    changesApi -> prefsStore 'reads prefs and the theme choice when their version moved'
    changesApi -> themeFiles 'reads the own themes when their version moved'
    changesApi -> templateStore 'reads the templates when their version moved'
    changesApi -> canvasStore 'reads the Canvas areas when their version moved'
    calendarService -> placeCodec 'keeps an event\'s place with'
    calendarService -> birthdayRules 'applies to birthdays'
    calendarService -> ownership 'marks look-only events and calendars with'
    calendarsApi -> calendarService 'lists the calendars through'
    calendarsApi -> prefsStore 'reads and saves the hidden flag in'
    pushApi -> webPush 'stores the subscription and the reminder plan in'
    backupApi -> backup 'creates and restores on request'
    backupCollectors -> backup 'registers the server-wide files with'
    backupCollectors -> peopleStore 'collects and restores'
    backupCollectors -> motivation 'collects and restores'
    backupCollectors -> settingsApi 'collects and restores the settings'
    backup -> driveClient 'uploads and reads versions through'
    driveClient -> google 'talks to Drive, or to a mock on disk'
    auth -> peopleStore 'looks up the allowed people in'
    auth -> secretBox 'seals each person\'s Google refresh token with'
    securityHeaders -> photon 'allows the origin in the CSP'
    securityHeaders -> osmTiles 'allows the origin in the CSP'
    itemsApi -> calendarService 'reads the range'
    calendarService -> tasksCalendar 'keeps task lists in'
    calendarService -> taskCodec 'encodes and decodes task lists with'
    calendarService -> googleProvider 'reads and writes through'
    calendarService -> mockProvider 'reads and writes through, when started with the mock'
    mockProvider -> rateGuard 'guards its calls with the same rate guard, so a test can make the next call rate limited'
    tasksCalendar -> googleProvider 'finds or creates the hidden calendar through'
    auth -> sessions 'keeps sessions and tokens in'
    auth -> backup 'restores a person with no data at sign-in'
    prefsApi -> backup 'marks the person changed'
    backup -> prefsStore 'collects and restores the person\'s files'
    backup -> sharedLists 'collects and restores the lists the person owns'
    sharedLists -> sharedStore 'reads and writes'
    calendarService -> sharedLists 'merges shared lists into reads and item changes; moves a list in and out when sharing starts and stops'
    googleProvider -> sessions 'uses the person\'s token from'
    googleProvider -> diag 'logs failed Google calls and cooldowns to'
    googleProvider -> rateGuard 'reads through its cache; holds every call during a cooldown'
    tasksApi -> calendarService 'stores the list with its tags'
    eventsApi -> calendarService 'writes the event'
    themesApi -> calendar.themeRules 'validates the document and sanitises the picture again'
    themesApi -> themeFiles 'reads and writes'
    backup -> themeFiles 'collects and restores, re-checking each theme like an import'
    canvasApi -> canvasStore 'reads and writes atomically'
    backup -> canvasStore 'collects and restores with the person\'s files'
    templatesApi -> templateStore 'reads and writes atomically'
    backup -> templateStore 'collects and restores with the person\'s files'
    calendarService -> reminderOverrides 'keeps and applies the reminders of events of read-only calendars (never asked at Google)'
    backup -> reminderOverrides 'collects and restores with the person\'s files'
    calendarService -> prefsStore 'reads what finishing an undated list does, on every completing write'
    calendarService -> googleProvider 'reads undated and finished lists by their private markers, without a date range'
  }

  calendar.server.googleProvider -> google 'lists, inserts, patches and deletes events and calendars'
  calendar.server.auth -> google 'signs the person in and receives their calendar access'
  calendar.server.webPush -> webPushServices 'sends each reminder at its time, never twice'
  calendar.server.backup -> google 'keeps the last 7 versions in the person\'s hidden Drive app folder'
  calendar.web.signin -> calendar.server.auth 'starts the sign-in and checks the session'
  calendar.web.sync -> calendar.server.diag 'sends one beacon when the error banner appears'

  calendar.web.prefs -> calendar.server.prefsApi 'patches preferences'
  calendar.web.items -> calendar.server.itemsApi 'fetches a range outside the device window when it is opened'
  calendar.web.liveSubscriber -> calendar.server.liveApi 'subscribes with one Server-Sent Events connection'
  calendar.server.googlePoller -> google 'asks for the changes made in Google Calendar itself, every 20 seconds while an app is open'
  calendar.web.sync -> calendar.server.changesApi 'asks for the changes since the device\'s cursor'
  calendar.web.items -> calendar.server.tasksApi 'saves item changes, applied optimistically'
  calendar.web.listForm -> calendar.server.tasksApi 'saves the list'
  calendar.web.pluginUi -> calendar.server.plugins 'reads the enabled plugins from the health answer'

  calendar.web.items -> calendar.server.eventsApi 'saves event changes, applied optimistically'
  calendar.web.settingsStore -> calendar.server.settingsApi 'saves a change against the version it last read'
  calendar.web.taskTray -> calendar.server.tasksApi 'reads the open and finished-today lists'
  calendar.web.pendingDeletes -> calendar.server.tasksApi 'deletes the list or item after the undo time'
  calendar.web.pendingDeletes -> calendar.server.eventsApi 'deletes the event after the undo time'
  calendar.web.updateCheck -> calendar.server.configApi 'reads the build version'
  calendar.web.whatsNew -> calendar.server.releaseNotes 'reads the notes'
  calendar.web.themeState -> calendar.server.prefsApi 'reads and patches the theme pref'
  calendar.web.themeState -> calendar.server.themesApi 'lists, saves and deletes own themes'
  calendar.web.tasksView -> calendar.server.tasksApi 'fetches every open list and the finished ones'
  calendar.web.tasksCanvas -> calendar.server.tasksApi 'saves a note\'s place on its list'
  calendar.web.tasksCanvas -> calendar.server.canvasApi 'reads and replaces the areas document'
  calendar.web.listForm -> calendar.server.templatesApi 'reads templates to start a list from, saves a list as one'
  calendar.web.settings -> calendar.server.templatesApi 'lists, renames, changes and deletes templates'
  calendar.web.reminderPlan -> calendar.server.webPush 'sends the next 7 days\' plan, in a subscribed browser'
  calendar.web.calendarsStore -> calendar.server.calendarsApi 'reads the calendars, saves the hidden flag'
  calendar.web.pushClient -> calendar.server.pushApi 'sends the subscription, reads the VAPID key'
  calendar.web.backupStore -> calendar.server.backupApi 'lists, creates and restores backups'
  calendar.web.motivationUi -> calendar.server.motivation 'reads the state; re-reads it on X-Motivation-Changed'
  calendar.web.apkHint -> calendar.server.apkDownload 'offers the newer app version for download'
}
