model {
  extend calendar.server {
    prefsApi = component 'Prefs API' {
      description 'Validates and persists preference changes'
    }
    prefsStore = store 'Stored prefs' {
      description 'Per-person preferences on disk, the source of truth'
    }
    tasksApi = component 'Tasks API' {
      description 'Creates and updates a person\'s task lists, their tags included'
    }
    calendarService = component 'Calendar service' {
      description 'Reads and writes one person\'s events and task lists through the calendar provider'
    }
    plugins = component 'Plugin registry' {
      description 'Mounts each optional plugin only when its configuration enables it, and lists the enabled ones in the health answer'
    }
    doorPlugin = component 'Door plugin' {
      description 'Optional, off by default: the read-only door answer for one machine client — open items of door-tagged lists and today\'s events of the key\'s person, titles and times only'
    }

    prefsApi -> prefsStore 'reads and writes'
    tasksApi -> calendarService 'stores the list with its tags'
    plugins -> doorPlugin 'mounts under /api/door when DOOR_API_TOKEN is set'
    doorPlugin -> calendarService 'reads the key\'s person\'s lists and events'
  }

  calendar.web.prefs -> calendar.server.prefsApi 'patches preferences'
  calendar.web.listForm -> calendar.server.tasksApi 'saves the list, Show on door as the door tag'
  calendar.web.listSheet -> calendar.server.tasksApi 'flips the door tag'
  calendar.web.pluginUi -> calendar.server.plugins 'reads the enabled plugins from the health answer'
}
