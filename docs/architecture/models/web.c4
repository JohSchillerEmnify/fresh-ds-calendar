model {
  extend calendar.web {
    settings = component 'Settings screen' {
      description 'Where the owner turns features on and off, including the experimental section'
    }
    prefs = store 'Prefs store' {
      description 'Per-person preferences, mirrored from the server'
    }
    week = component 'Week view' {
      description 'Shows one week; renders the overview or the normal grid depending on prefs'
    }
    overview = component 'Two-row week overview' {
      #experimental
      description 'Lays the week in two rows that fit one screen, entries to scale over a shared active-hours window'
    }
    timegrid = component 'Time grid' {
      description 'The normal day and week 24-hour scrolling grid'
    }
    primitives = library 'Layout primitives' {
      description 'Overlap packing, all-day packing and the item block renderer, shared by the grids'
    }

    settings -> prefs 'changes the overview and split prefs'
    week -> prefs 'reads the overview and split prefs'
    week -> overview 'renders when the overview is on'
    week -> timegrid 'renders when the overview is off'
    overview -> primitives 'reuses'
    timegrid -> primitives 'reuses'
  }
}
