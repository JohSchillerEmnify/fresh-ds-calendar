specification {
  element person {
    style {
      shape person
    }
  }
  element system
  element app {
    style {
      shape rectangle
    }
  }
  element component
  element store {
    style {
      shape storage
    }
  }
  element library {
    style {
      color muted
    }
  }

  deploymentNode environment
  deploymentNode node
  deploymentNode device

  tag experimental
  tag external
}

model {
  owner = person 'Owner' {
    description 'The person whose calendar this is'
  }

  calendar = system 'Calendar' {
    description 'Personal calendar app'

    web = app 'Web app' {
      description 'Vue 3 PWA the owner interacts with'
    }
    server = app 'Server' {
      description 'Hono API that stores per-person preferences'
    }
    widget = app 'Phone widget' {
      description 'Native Android home-screen widget that draws the current week'
    }
  }

  google = system 'Google' {
    #external
    description 'Each person\'s Google account: sign-in, their calendars (where events and task lists live) and Drive'
  }

  doorBoard = system 'Door board' {
    #external
    description 'The e-ink screen inside the front door and its renderer on the home server; shows reminders before leaving'
  }

  owner -> calendar.web 'views and manages the calendar'
  calendar.web -> calendar.server 'reads and writes preferences'
  owner -> calendar.widget 'glances at the week'
  calendar.web -> calendar.widget 'pushes a week snapshot through the widget bridge'
  calendar.widget -> calendar.server 'reads the week and the preferences with the app session'
  doorBoard -> calendar.server 'reads reminders and today\'s events with its key'
}
