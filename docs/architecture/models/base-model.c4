specification {
  element person {
    style {
      shape person
    }
  }
  element system
  element app {
    style {
      shape rectangle
    }
  }
  element component
  element store {
    style {
      shape storage
    }
  }
  element library {
    style {
      color muted
    }
  }

  deploymentNode environment
  deploymentNode node
  deploymentNode device

  tag experimental
  tag external
}

model {
  owner = person 'Owner' {
    description 'The person whose calendar this is'
  }

  calendar = system 'Calendar' {
    description 'Personal calendar app'

    web = app 'Web app' {
      description 'Vue 3 PWA the owner interacts with'
    }
    server = app 'Server' {
      description 'Hono API that stores per-person preferences'
    }
    widget = app 'Phone widget' {
      description 'Native Android home-screen widgets (week, day and clock) that draw the current days'
    }
    iosWidget = app 'iPhone widget' {
      description 'A Scriptable script on the iPhone that draws today, today and tomorrow, the week as a time grid and the lock screen with a per-device read key, in the person\'s language, and keeps its last answer'
    }
    androidApp = app 'Android app' {
      description 'The Capacitor shell that shows the chosen server\'s web app and carries the native plugins'
    }
    themeRules = library 'Theme rules' {
      description 'The calendar-theme/2 document schema, its validator and the SVG picture sanitiser, shared by web and server'
    }
  }

  google = system 'Google' {
    #external
    description 'Each person\'s Google account: sign-in, their calendars (where events and task lists live), Drive and, if allowed, the dates of their contacts'
  }

  aiChat = system 'AI chat' {
    #external
    description 'Any AI chat the person likes; the app never calls it'
  }

  webPushServices = system 'Push services' {
    #external
    description 'The browsers\' push services that deliver a Web Push to a closed browser'
  }

  osmTiles = system 'OpenStreetMap tiles' {
    #external
    description 'The map tile server (MAP_TILE_URL) the browser loads event map pictures from'
  }

  photon = system 'Photon place search' {
    #external
    description 'The geocoder (PLACE_SEARCH_URL) the browser asks for place suggestions'
  }

  owner -> calendar.web 'views and manages the calendar'
  calendar.web -> calendar.server 'reads and writes preferences'
  owner -> calendar.widget 'glances at the week'
  calendar.web -> calendar.widget 'pushes a week snapshot through the widget bridge'
  calendar.widget -> calendar.server 'reads the week and the preferences with the app session'
  owner -> calendar.iosWidget 'glances at today and the week'
  calendar.iosWidget -> calendar.server 'reads today and the week with a widget key (no session)'
  owner -> calendar.androidApp 'uses the calendar on the phone'
  owner -> aiChat 'asks for a theme with the copied prompt, pastes the answer back'
  calendar.web -> photon 'asks for place suggestions straight from the browser'
  calendar.web -> osmTiles 'loads map tiles straight from the browser'
}
