views {
  view index {
    title 'Calendar — landscape'
    include *
  }

  view web of calendar.web {
    title 'Web app — two-row week overview'
    include *
  }

  dynamic view turnOnOverview {
    title 'Turning on the two-row week overview'

    owner -> calendar.web.settings 'turns on the overview (experimental)'
    calendar.web.settings -> calendar.web.prefs 'saves the pref'
    calendar.web.prefs -> calendar.server.prefsApi 'patches preferences'
    owner -> calendar.web.week 'opens the week'
    calendar.web.week -> calendar.web.prefs 'reads overview and split'
    calendar.web.week -> calendar.web.timegrid 'renders two fit-mode grids'
  }

  view widget of calendar.widget {
    title 'Phone widget'
    include *
  }

  dynamic view setMinEventLength {
    title 'Setting a minimum event length'

    owner -> calendar.web.settings 'chooses 30 minutes'
    calendar.web.settings -> calendar.web.prefs 'saves the pref'
    calendar.web.prefs -> calendar.server.prefsApi 'patches preferences'
    owner -> calendar.web.timegrid 'looks at the day'
    calendar.web.timegrid -> calendar.web.prefs 'reads the minimum event length'
    calendar.web.timegrid -> calendar.web.primitives 'packs with the minimum: short entries laid out as 30 minutes'
    calendar.widget.fetcher -> calendar.server.prefsApi 'reads the minimum event length with the week'
    calendar.widget.fetcher -> calendar.widget.store 'saves both'
    calendar.widget.renderer -> calendar.widget.layout 'packs each day with the minimum'
  }

  dynamic view resizeBelowMinimum {
    title 'Shortening an entry below the minimum'

    owner -> calendar.web.resize 'drags the end handle to 15 minutes'
    calendar.web.resize -> calendar.web.primitives 'previews the block at the 30-minute minimum'
    calendar.web.resize -> calendar.server 'saves the real end'
  }

  view server of calendar.server {
    title 'Server — prefs, tasks and the door'
    include *
  }

  dynamic view doorRead {
    title 'The door board reads its reminders and today\'s events'

    calendar.web.pluginUi -> calendar.server.plugins 'sees the door plugin enabled'
    owner -> calendar.web.listForm 'turns Show on door on for a list'
    calendar.web.listForm -> calendar.server.tasksApi 'saves the list with the door tag'
    doorBoard -> calendar.server.doorPlugin 'asks with its key'
    calendar.server.doorPlugin -> calendar.server.calendarService 'reads the key\'s person\'s door-tagged lists and today\'s events'
    calendar.server.doorPlugin -> doorBoard 'answers open items (latest due occurrence only) and today\'s titles and times'
  }
}
