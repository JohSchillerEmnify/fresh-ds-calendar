views {
  view index {
    title 'Calendar — landscape'
    include *
  }

  view web of calendar.web {
    title 'Web app — two-row week overview'
    include *
  }

  dynamic view turnOnOverview {
    title 'Turning on the two-row week overview'

    owner -> calendar.web.settings 'turns on the overview (experimental)'
    calendar.web.settings -> calendar.web.prefs 'saves the pref'
    calendar.web.prefs -> calendar.server.prefsApi 'patches preferences'
    owner -> calendar.web.week 'opens the week'
    calendar.web.week -> calendar.web.prefs 'reads overview and split'
    calendar.web.week -> calendar.web.timegrid 'renders two fit-mode grids'
  }

  view server of calendar.server {
    title 'Server — prefs, tasks and the door'
    include *
  }

  dynamic view doorRead {
    title 'The door board reads its reminders and today\'s events'

    owner -> calendar.web.listForm 'turns Show on door on for a list'
    calendar.web.listForm -> calendar.server.tasksApi 'saves the list with the door tag'
    doorBoard -> calendar.server.doorApi 'asks with its key'
    calendar.server.doorApi -> calendar.server.calendarService 'reads the key\'s person\'s door-tagged lists and today\'s events'
    calendar.server.doorApi -> doorBoard 'answers open items (latest due occurrence only) and today\'s titles and times'
  }
}
