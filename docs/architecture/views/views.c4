views {
  view index {
    title 'Calendar — landscape'
    include *
  }

  view web of calendar.web {
    title 'Web app'
    include *
  }

  dynamic view turnOnOverview {
    title 'Turning on the two-row week overview'

    owner -> calendar.web.settings 'turns on the overview (experimental)'
    calendar.web.settings -> calendar.web.prefs 'saves the pref'
    calendar.web.prefs -> calendar.server.prefsApi 'patches preferences'
    owner -> calendar.web.week 'opens the week'
    calendar.web.week -> calendar.web.prefs 'reads overview and split'
    calendar.web.week -> calendar.web.timegrid 'renders two fit-mode grids'
  }

  view widget of calendar.widget {
    title 'Phone widget'
    include *
  }

  view androidApp of calendar.androidApp {
    title 'Android app'
    include *
  }

  dynamic view setMinEventLength {
    title 'Setting a minimum event length'

    owner -> calendar.web.settings 'chooses 30 minutes'
    calendar.web.settings -> calendar.web.prefs 'saves the pref'
    calendar.web.prefs -> calendar.server.prefsApi 'patches preferences'
    owner -> calendar.web.timegrid 'looks at the day'
    calendar.web.timegrid -> calendar.web.prefs 'reads the minimum event length'
    calendar.web.timegrid -> calendar.web.primitives 'packs with the minimum: short entries laid out as 30 minutes'
    calendar.widget.fetcher -> calendar.server.prefsApi 'reads the minimum event length with the week'
    calendar.widget.fetcher -> calendar.widget.store 'saves both'
    calendar.widget.renderer -> calendar.widget.layout 'packs each day with the minimum'
  }

  dynamic view resizeBelowMinimum {
    title 'Shortening an entry below the minimum'

    owner -> calendar.web.resize 'drags the end handle to 15 minutes'
    calendar.web.resize -> calendar.web.primitives 'previews the block at the 30-minute minimum'
    calendar.web.resize -> calendar.server 'saves the real end'
  }

  view server of calendar.server {
    title 'Server'
    include *
  }
}

views {
  deployment view prod {
    title 'Where it runs'
    include prod.**
  }

  deployment view home {
    title 'Home server demo'
    include home.**
  }

  dynamic view loadRange {
    title 'Loading the visible range'

    owner -> calendar.web.timegrid 'opens a week'
    calendar.web.sync -> calendar.web.items 're-fetches the visible range'
    calendar.web.items -> calendar.server.itemsApi 'fetches the range'
    calendar.server.itemsApi -> calendar.server.calendarService 'reads the range'
    calendar.server.calendarService -> calendar.server.googleProvider 'lists each calendar\'s events and the task lists'
    calendar.server.googleProvider -> calendar.server.rateGuard 'serves a fresh cached read, else lets the call through'
    calendar.server.googleProvider -> google 'lists events'
  }

  dynamic view rateLimitedRead {
    title 'Google asks the app to slow down'

    calendar.server.googleProvider -> google 'lists events'
    google -> calendar.server.googleProvider 'asks to slow down'
    calendar.server.googleProvider -> calendar.server.rateGuard 'starts a cooldown, longer each time it repeats'
    calendar.web.items -> calendar.server.itemsApi 'fetches the range on the next poll'
    calendar.server.itemsApi -> calendar.server.calendarService 'reads the range'
    calendar.server.calendarService -> calendar.server.googleProvider 'lists events'
    calendar.server.googleProvider -> calendar.server.rateGuard 'answers from the cache, makes no Google call'
    calendar.server.itemsApi -> calendar.web.items 'answers the last known data, marked stale'
    calendar.web.items -> calendar.web.sync 'reports no error: no banner'
  }

  dynamic view openingWithLastKnownState {
    title 'Opening the app on a bad connection'

    owner -> calendar.web.appShell 'opens the app'
    calendar.web.appShell -> calendar.web.lastKnown 'opens the device store of the person last signed in'
    calendar.web.lastKnown -> calendar.web.items 'feeds the events (±1 year) and every task list'
    calendar.web.lastKnown -> calendar.web.settingsStore 'feeds settings, prefs, calendars and themes'
    calendar.web.appShell -> owner 'shows the calendar at once with "Last updated 08:12"'
    calendar.web.sync -> calendar.server.changesApi 'asks for the changes since the cursor, in the background'
    calendar.server.changesApi -> calendar.web.sync 'answers (or not: the banner shows, the device data stays)'
    calendar.web.sync -> calendar.web.lastKnown 'takes the changes in and keeps the new cursor'
  }

  dynamic view syncingTheDeviceStore {
    title 'A change made elsewhere reaches the device store'

    calendar.web.sync -> calendar.server.changesApi 'asks for the changes since the cursor (focus, reconnect, poll)'
    calendar.server.changesApi -> calendar.server.calendarService 'events and task lists changed since each sync token'
    calendar.server.calendarService -> calendar.server.googleProvider 'events.list with the sync token, all pages'
    calendar.server.googleProvider -> google 'lists the changes, deleted ones included'
    google -> calendar.server.googleProvider 'answers 410 Gone when the token expired'
    calendar.server.calendarService -> calendar.server.googleProvider 'lists that calendar again in full, for a new token'
    calendar.server.changesApi -> calendar.server.prefsStore 'reads the prefs when their version moved'
    calendar.server.changesApi -> calendar.web.sync 'changed and removed things per kind, a new cursor; a full kind marked as replacing'
    calendar.web.sync -> calendar.web.lastKnown 'applies them, drops what left the ±1 year window'
    calendar.web.lastKnown -> calendar.web.items 'the views show the change'
  }

  dynamic view liveSync {
    title 'A change on one device reaches the other open apps within a second'

    calendar.web.items -> calendar.server.tasksApi 'saves the change'
    calendar.server.tasksApi -> calendar.server.publisher 'publishes after it was saved'
    calendar.server.publisher -> calendar.server.liveApi 'changed, to every open app of the person and of each list member'
    calendar.server.liveApi -> calendar.web.liveSubscriber 'a content-free changed nudge'
    calendar.web.liveSubscriber -> calendar.web.sync 'asks for a sync at once'
    calendar.web.sync -> calendar.server.changesApi 'asks for the changes since the cursor'
    calendar.server.googlePoller -> google 'every 20 seconds while an app is open: changes made in Google Calendar'
    calendar.server.googlePoller -> calendar.server.publisher 'publishes when Google reported changes'
  }

  dynamic view sendingOfflineChanges {
    title 'A change made offline is kept and sent later'

    owner -> calendar.web.items 'ticks "Milk" without a connection'
    calendar.web.items -> calendar.web.lastKnown 'shows it at once, no mark'
    calendar.web.items -> calendar.web.outbox 'appends the change with the version it was based on'
    calendar.web.sync -> calendar.web.outboxSender 'the connection is back: send first'
    calendar.web.outboxSender -> calendar.web.outbox 'takes the oldest entry'
    calendar.web.outboxSender -> calendar.server.tasksApi 'sends it with its key; on a stale version again with the newest one'
    calendar.server.tasksApi -> calendar.web.outboxSender 'answers with the stored version, or refuses'
    calendar.web.outboxSender -> calendar.web.lastKnown 'replaces the copy with the answer'
    calendar.web.outboxSender -> calendar.web.snackbar 'a refused change is undone and reported'
    calendar.server.tasksApi -> calendar.server.publisher 'publishes after it was saved: other open apps take it in'
    calendar.web.sync -> calendar.web.syncFailedIcon 'only after 5 minutes without a success: shows the icon and the unsent list'
  }

  dynamic view firstTaskList {
    title 'A person\'s first task list'

    owner -> calendar.web.listForm 'creates "Groceries"'
    calendar.web.listForm -> calendar.server.tasksApi 'saves the list'
    calendar.server.tasksApi -> calendar.server.calendarService 'stores the list'
    calendar.server.calendarService -> calendar.server.tasksCalendar 'gets the person\'s tasks calendar'
    calendar.server.tasksCalendar -> calendar.server.googleProvider 'creates it hidden, once'
    calendar.server.calendarService -> calendar.server.taskCodec 'encodes the list as an event'
    calendar.server.calendarService -> calendar.server.googleProvider 'inserts the event into the tasks calendar'
  }

  dynamic view signIn {
    title 'Signing in'

    owner -> calendar.web.signin 'taps Sign in with Google'
    calendar.web.signin -> calendar.server.auth 'starts the sign-in'
    calendar.server.auth -> google 'one round trip: sign-in and calendar access'
    google -> calendar.server.auth 'the verified address and the token'
    calendar.server.auth -> calendar.server.sessions 'stores the token and a session, only for an allowed address'
    calendar.server.auth -> calendar.web.signin 'the session cookie; back to the page asked for'
  }

  dynamic view backupAfterChange {
    title 'Backing up after a change'

    owner -> calendar.web.prefs 'changes a setting'
    calendar.web.prefs -> calendar.server.prefsApi 'patches preferences'
    calendar.server.prefsApi -> calendar.server.backup 'marks the person changed'
    calendar.server.backup -> calendar.server.prefsStore 'collects the person\'s files, once the person stops for a while'
    calendar.server.backup -> google 'uploads a new version; drops the oldest beyond 7'
  }

  dynamic view restoreAtSignIn {
    title 'A fresh server restores a person at sign-in'

    owner -> calendar.web.signin 'signs in'
    calendar.web.signin -> calendar.server.auth 'starts the sign-in'
    calendar.server.auth -> calendar.server.backup 'the person has no data here'
    calendar.server.backup -> google 'reads the newest readable version'
    calendar.server.backup -> calendar.server.prefsStore 'writes the person\'s files back'
    calendar.server.backup -> calendar.server.sharedLists 'recreates the lists the person owns'
    calendar.server.auth -> calendar.web.signin 'signed in, data back'
  }

  dynamic view shareList {
    title 'Sharing a task list'

    owner -> calendar.web.listForm 'shares "Groceries" with Anna'
    calendar.web.listForm -> calendar.server.tasksApi 'shares the list'
    calendar.server.tasksApi -> calendar.server.calendarService 'moves the list'
    calendar.server.calendarService -> calendar.server.sharedLists 'stores it shared, Anna a member'
    calendar.server.calendarService -> calendar.server.googleProvider 'deletes the event from the tasks calendar'
    calendar.web.items -> calendar.server.itemsApi 'Anna\'s next sync'
    calendar.server.itemsApi -> calendar.server.calendarService 'reads Anna\'s range'
    calendar.server.calendarService -> calendar.server.sharedLists 'merges in the lists Anna may see'
  }

  // Web app core
  dynamic view switchView {
    title 'Switching from the month to the week'

    owner -> calendar.web.viewSwitcher 'taps Week while 2026-10-14 is focused'
    calendar.web.viewSwitcher -> calendar.web.router 'navigates to the week containing the focus date'
    calendar.web.router -> calendar.web.periodStore 'keeps the focus date, it lies inside the new week'
    calendar.web.router -> calendar.web.week 'shows the week of 2026-10-12'
    calendar.web.sync -> calendar.web.items 're-fetches the visible range'
  }

  dynamic view settingFailsToSave {
    title 'A setting that cannot be saved'

    owner -> calendar.web.settings 'chooses Week as the default view'
    calendar.web.settings -> calendar.web.settingsStore 'applies it at once'
    calendar.web.settingsStore -> calendar.server.settingsApi 'saves it; the network is gone'
    calendar.web.settingsStore -> calendar.web.settings 'rolls back to Month'
    calendar.web.settingsStore -> calendar.web.sync 'reports it: the error banner'
  }

  // Overlays, bedtime and updates
  dynamic view deleteWithUndo {
    title 'Deleting with undo'

    owner -> calendar.web.pendingDeletes 'deletes "Dentist"'
    calendar.web.pendingDeletes -> calendar.web.items 'hides it at once'
    calendar.web.pendingDeletes -> calendar.web.snackbar 'shows "Deleted: Dentist" with Undo'
    calendar.web.pendingDeletes -> calendar.server.eventsApi 'sends the delete when the undo time is over, or at once when the app is hidden'
  }

  dynamic view bedtimeNight {
    title 'A night under bedtime mode'

    owner -> calendar.web.settings 'turns bedtime on, based on the first appointment'
    calendar.web.settings -> calendar.web.prefs 'saves the bedtime pref'
    calendar.web.bedtime -> calendar.web.items 'reads tomorrow\'s first timed entry'
    calendar.web.bedtime -> calendar.web.timegrid 'draws the night band, never later than the fixed bedtime'
    calendar.web.clock -> calendar.web.bedtime 'ticks'
    calendar.web.bedtime -> calendar.web.snackbar 'Bedtime in 30 minutes, once per night'
    calendar.web.bedtime -> calendar.androidApp.nativeReminders 'in the app: schedules it as a notification too'
  }

  dynamic view appUpdate {
    title 'The installed app updates itself'

    calendar.web.sync -> calendar.web.updateCheck 'synced'
    calendar.web.updateCheck -> calendar.server.configApi 'reads the build version'
    calendar.web.updateCheck -> calendar.web.serviceWorker 'installs the newest worker'
    calendar.web.updateCheck -> calendar.web.serviceWorker 'activates it and reloads once no dialog is open'
    calendar.web.whatsNew -> calendar.server.releaseNotes 'reads the notes'
    calendar.web.whatsNew -> calendar.web.snackbar 'says once what is new'
  }

  // Labs
  dynamic view chooseLabsViews {
    title 'Choosing which Labs views are offered'

    owner -> calendar.web.settings 'turns on experimental views and switches Strip on'
    calendar.web.settings -> calendar.web.labsRegistry 'lists one switch per Labs view'
    calendar.web.settings -> calendar.web.prefs 'saves the Labs switch and the choice'
    calendar.web.prefs -> calendar.server.prefsApi 'patches preferences'
    calendar.web.viewSwitcher -> calendar.web.prefs 'reads the Labs switch and the choices'
    calendar.web.viewSwitcher -> calendar.web.labsRegistry 'offers the main views that are on, then Plain clock, Timeline and Strip: choices, else defaults'
  }

  // Themes
  dynamic view chooseThemeSeasonal {
    title 'Choosing Neon while Seasons & holidays is Header + colours'

    owner -> calendar.web.themeMenu 'chooses Neon on 24 December'
    calendar.web.themeMenu -> calendar.web.themeState 'preset Neon, overrides cleared, Header + colours steps down to Header only'
    calendar.web.themeState -> calendar.web.themeEngine 'resolves Neon colours with the calendar\'s Christmas scene'
    calendar.web.topBarScene -> calendar.web.themeState 'draws the Christmas timeline'
    calendar.web.themeState -> calendar.server.prefsApi 'patches the theme pref in the background'
  }

  dynamic view importOwnTheme {
    title 'Making an own theme with an AI'

    owner -> calendar.web.themeMenu 'copies the Create with AI prompt (Labs)'
    owner -> aiChat 'asks for a theme with the prompt'
    owner -> calendar.web.themeMenu 'pastes the answer'
    calendar.web.themeMenu -> calendar.themeRules 'tidies, validates and previews the document'
    calendar.web.themeMenu -> calendar.web.themeState 'saves the theme and chooses it'
    calendar.web.themeState -> calendar.server.themesApi 'saves the document and picture'
    calendar.server.themesApi -> calendar.themeRules 'validates and sanitises again'
    calendar.server.themesApi -> calendar.server.themeFiles 'stores the theme'
  }

  // Task lists
  dynamic view tapTaskList {
    title 'Tapping a task list in the week'

    owner -> calendar.web.timegrid 'taps "Groceries"'
    calendar.web.grownCard -> calendar.web.prefs 'reads the tap setting and the Labs switch'
    calendar.web.timegrid -> calendar.web.grownCard 'grows the card in place (experiment on, setting inline)'
    owner -> calendar.web.grownCard 'taps the grown card'
    calendar.web.grownCard -> calendar.web.listSheet 'opens the list sheet'
    calendar.web.listSheet -> calendar.server.tasksApi 'ticks an item'
  }

  dynamic view moveNote {
    title 'Moving a note on the Canvas'

    owner -> calendar.web.tasksCanvas 'long-presses "Taxes" and drops it in "Haus"'
    calendar.web.tasksCanvas -> calendar.server.tasksApi 'saves the place on the list; a move never conflicts with item edits'
    calendar.server.tasksApi -> calendar.server.calendarService 'stores the place'
    calendar.server.calendarService -> calendar.server.taskCodec 'writes the place into the event'
    calendar.server.calendarService -> calendar.server.googleProvider 'patches the event'
    calendar.web.tasksCanvas -> calendar.server.canvasApi 'replaces the areas after an area edit'
    calendar.server.canvasApi -> calendar.server.canvasStore 'writes the document'
  }

  dynamic view finishList {
    title 'Finishing the last item of an undated list'

    owner -> calendar.web.tasksView 'ticks the last item of "Taxes"'
    calendar.web.tasksView -> calendar.web.items 'ticks it at once'
    calendar.web.items -> calendar.server.tasksApi 'saves the tick'
    calendar.server.tasksApi -> calendar.server.calendarService 'stores the list'
    calendar.server.calendarService -> calendar.server.prefsStore 'reads what finishing an undated list does'
    calendar.server.calendarService -> calendar.server.taskCodec 'dates it to today (or keeps it undated) and marks it finished'
    calendar.server.calendarService -> calendar.server.googleProvider 'patches the event'
    calendar.web.tasksView -> calendar.server.tasksApi 'reads the Archive: marked lists of any age plus the recent range'
  }

  // Android app, widget and reminders
  dynamic view startApp {
    title 'Starting the Android app (ADR 0022: one configured server)'

    owner -> calendar.androidApp.shell 'opens the app: no question, the server is configuration'
    calendar.androidApp.shell -> calendar.web.appShell 'loads https://cal.example.org\'s web app, plugins working'
    calendar.widget.fetcher -> calendar.server.itemsApi 'reads the week from the same server'
  }

  dynamic view signInFromApp {
    title 'Signing in from the Android app'

    owner -> calendar.web.signin 'taps Sign in with Google'
    calendar.web.signin -> calendar.androidApp.appSignIn 'hands over the sign-in start'
    calendar.androidApp.appSignIn -> calendar.server.auth 'opens the start in the system browser, with a challenge'
    calendar.server.auth -> google 'sign-in and calendar access, in the system browser'
    calendar.server.auth -> calendar.androidApp.appSignIn 'a deep link with a one-time code'
    calendar.androidApp.appSignIn -> calendar.server.auth 'exchanges the code with the verifier'
    calendar.server.auth -> calendar.web.signin 'the session cookie in the app; on to the week'
  }

  dynamic view widgetWeekRefresh {
    title 'The widget refreshes its week'

    calendar.web.widgetBridge -> calendar.widget.store 'saves the snapshot after a sync, only when it changed'
    calendar.widget.fetcher -> calendar.server.itemsApi 'reads the current week with the app\'s session; the server leaves out hidden calendars'
    calendar.widget.fetcher -> calendar.widget.store 'saves the week'
    calendar.widget.renderer -> calendar.widget.store 'picks the fetched week, else the snapshot; theme and language from the snapshot'
    calendar.widget.renderer -> calendar.widget.layout 'packs each day'
    owner -> calendar.widget.renderer 'sees the new picture; nothing is redrawn when nothing changed'
  }

  dynamic view remindersRing {
    title 'Reminders ring on the phone and in a closed browser'

    calendar.web.sync -> calendar.web.items 're-fetches the range'
    calendar.web.reminderPlan -> calendar.web.items 'reads the reminder lists from Google'
    calendar.web.reminderPlan -> calendar.web.snackbar 'rings while the app is open'
    calendar.web.reminderPlan -> calendar.androidApp.nativeReminders 'in the app: schedules the next notifications'
    calendar.web.reminderPlan -> calendar.server.webPush 'in a subscribed browser: sends the next 7 days\' plan'
    calendar.server.webPush -> webPushServices 'sends each reminder at its time'
  }
}
