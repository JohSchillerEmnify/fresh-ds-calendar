{
  "name": "calendar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "pnpm -F @calendar/web build && pnpm -F @calendar/server build",
    "build:e2e": "pnpm -F @calendar/web build:e2e && pnpm -F @calendar/server build:e2e",
    "test": "pnpm -F @calendar/server test && pnpm -F @calendar/web test",
    "size": "pnpm -F @calendar/web size",
    "i18n:check": "pnpm -F @calendar/web i18n:check",
    "dev:server": "pnpm -F @calendar/server dev",
    "dev:web": "pnpm -F @calendar/web dev",
    "redeploy": "bash scripts/deploy.sh",
    "e2e": "bash e2e/run.sh",
    "verify": "node scripts/verify.mjs",
    "i18n:scan": "node web/scripts/i18n-scan.ts",
    "ui-texts": "node web/scripts/ui-texts.ts",
    "e2e:affected": "node scripts/e2e-affected.mjs",
    "goldens": "bash scripts/goldens.sh run",
    "goldens:update": "bash scripts/goldens.sh update",
    "dedup": "jscpd web/src server/src shared",
    "lint": "eslint .",
    "quality": "node scripts/quality.mjs check",
    "quality:ratchet": "node scripts/quality.mjs ratchet",
    "hooks:install": "bash scripts/hooks/install.sh",
    "leaks": "bash scripts/leak-check.sh all"
  },
  "engines": {
    "node": ">=24.11"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/share": "8.0.3",
    "@eslint/js": "^10.0.1",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "jscpd": "^5.4.2",
    "knip": "^6.43.0",
    "opentype.js": "^2.0.0",
    "svg2vectordrawable": "^2.9.1",
    "typescript-eslint": "^8.72.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "license": "AGPL-3.0-only"
}
