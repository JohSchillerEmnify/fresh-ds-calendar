{
  "name": "calendar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "pnpm -F @calendar/web build && pnpm -F @calendar/server build",
    "build:e2e": "pnpm -F @calendar/web build:e2e && pnpm -F @calendar/server build:e2e",
    "test": "pnpm -F @calendar/server test && pnpm -F @calendar/web test",
    "size": "pnpm -F @calendar/web size",
    "i18n:check": "pnpm -F @calendar/web i18n:check",
    "dev:server": "pnpm -F @calendar/server dev",
    "dev:web": "pnpm -F @calendar/web dev",
    "redeploy": "bash scripts/deploy.sh",
    "e2e": "bash e2e/run.sh",
    "verify": "node scripts/verify.mjs",
    "i18n:scan": "node web/scripts/i18n-scan.ts",
    "e2e:affected": "node scripts/e2e-affected.mjs"
  },
  "engines": {
    "node": ">=24.11"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3"
  }
}
